# Normalize line endings: LF in the repository, native on checkout — except
# shell scripts, which break under CRLF on Unix.
* text=auto
mvnw text eol=lf
*.sh text eol=lf
*.java text working-tree-encoding=UTF-8 eol=lf
*.sql text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.js text eol=lf
*.html text eol=lf
